FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY ember/package*.json ./ember/
RUN cd ember && npm ci --ignore-scripts --omit=dev && npm cache clean --force
COPY app.py protocol.py run_debian.py ./
COPY ember/provider.js ./ember/
COPY static ./static/
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 CONFIG_PATH=/data/config.json WEB_PORT=8080
EXPOSE 8080/tcp 9000/tcp 50080/udp
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2); urllib.request.urlopen('http://127.0.0.1:9091/status', timeout=2)"
CMD ["python3", "run_debian.py"]
